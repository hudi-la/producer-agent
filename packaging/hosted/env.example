# /etc/fairwind/env —— 只有这台机器上的 fairwind 用户和 root 能读(chmod 600)。
# service_role 只在这里,不进代码库;脑子拿它只做三件事:找活、查人、替人造会话。
FAIRWIND_MODE=hosted
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BRAIN_PORT=8788
BRAIN_HOST=127.0.0.1
BRAIN_ORIGIN=https://fairwind.<域名>
NODE_ENV=production
# Gmail 应用(2026-10-06,设计稿 docs/specs/2026-10-06-hosted-gmail-design.md):运营方的,不是谁个人的钥匙。
# Google Cloud 里 Web application 类型的 OAuth client;回调要逐字登记 ${BRAIN_ORIGIN}/oauth/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
