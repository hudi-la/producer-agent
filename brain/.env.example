# 复制成 brain/.env 再填。这个文件里的 key 权限很大，别提交、别进前端。
#
# SUPABASE_URL —— 跟前端 .env.local 里的 VITE_SUPABASE_URL 一样
SUPABASE_URL=https://xxxxxxxx.supabase.co
#
# SUPABASE_SERVICE_ROLE_KEY —— Supabase 后台 → Project Settings → API Keys → service_role
# 注意：这不是前端那个 anon key。service_role 能绕过 RLS 读写整个库，
# 所以它只许待在这台机器上的这个文件里。
SUPABASE_SERVICE_ROLE_KEY=

# 可选
BRAIN_PORT=8788
BRAIN_ORIGIN=http://localhost:5173

# ── 接上 Gmail（全局邮件同步用）────────────────────────────────
# 在 Google Cloud 建一个 **Desktop app** 类型的 OAuth 客户端，把它给的
# 两个值填这儿。详细几步写在 brain/README.md 的「接上 Gmail」那节。
#
# 要紧的一条：同意屏幕的发布状态必须设成 **In production**。
# 停在 Testing 的话，Google 发的 refresh token 7 天就过期——对一个天天
# 在用的系统，那等于每周挂一次。
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# 可选：授权回调听哪个口。默认 8789。
# 只有当你复用一条 **Web application** 类型的现成 client、而它登记的
# redirect URI 是别的端口时才需要改这个（Desktop app 类型任意端口都行）。
GMAIL_CALLBACK_PORT=8789
